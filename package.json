{
  "name": "ai-poker",
  "version": "0.1.0",
  "description": "AI Poker — Telegram Mini App for heads-up NLHE on TON. Phase 1: game server.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run build:client && node src/index.js",
    "dev": "node --watch src/index.js",
    "build:client": "cd client && npm install && npm run build",
    "test": "node --test src/test/legacy.test.js src/test/verifyScripts.test.js",
    "test:client": "cd client && npm test",
    "test:all": "npm test && npm run test:client",
    "test:e2e": "node --test src/test/e2e.test.js",
    "test:live": "node src/server/agentChat.test.js",
    "test:data": "node scripts/verify-chips.js",
    "export:json": "node scripts/export-json.js",
    "smoke": "node scripts/smoke-hand.js",
    "smoke:agent": "node scripts/smoke-agent-profile.js",
    "smoke:ws": "node scripts/smoke-ws.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "better-sqlite3": "13.0.3",
    "express": "^4.21.1",
    "pokersolver": "^2.1.4",
    "ws": "^8.18.0"
  },
  "author": "Jens",
  "license": "UNLICENSED",
  "private": true,
  "overrides": {
    "qs": "^6.16.0"
  }
}
